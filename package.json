{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "typecheck": "tsc -b --pretty false",
    "typecheck:app": "tsc -p tsconfig.app.json --pretty false --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --pretty false --noEmit",
    "lint": "eslint .",
    "lint:prod": "eslint \"src/**/*.{ts,tsx}\" --ignore-pattern \"**/*.test.ts\" --ignore-pattern \"**/*.test.tsx\" --ignore-pattern \"src/test/**\"",
    "lint:tests": "eslint \"src/**/*.test.{ts,tsx}\" \"src/test/**/*.{ts,tsx}\"",
    "lint:architecture": "eslint \"src/**/*.{ts,tsx}\" --rule \"@typescript-eslint/no-explicit-any:off\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "cross-env NODE_OPTIONS='--max-old-space-size=4096' vitest run --coverage",
    "test:coverage:ui": "cross-env NODE_OPTIONS='--max-old-space-size=4096' vitest --ui --coverage",
    "test:performance": "cross-env VITEST_PERFORMANCE=true vitest run src/test/performance.test.ts",
    "test:e2e": "cross-env VITEST_INTEGRATION=true vitest run src/test/e2e-integration.test.ts",
    "catalog:import-drive": "node scripts/catalog/import-drive-manifest.mjs",
    "catalog:publish-ready": "node scripts/catalog/publish-ready-catalog-items.mjs",
    "catalog:dedupe": "node scripts/catalog/backfill-dedupe-metadata.mjs",
    "catalog:health": "node scripts/catalog/catalog-health-report.mjs",
    "catalog:clean-public-tags": "node scripts/catalog/clean-public-model-tags.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\" \"*.{json,md}\"",
    "prepare": "husky",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:dev:stop": "docker-compose -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker-compose -f docker-compose.dev.yml logs -f",
    "docker:prod:build": "docker build -t ordax-app:latest .",
    "docker:prod": "docker-compose up -d",
    "docker:prod:stop": "docker-compose down",
    "docker:prod:logs": "docker-compose logs -f",
    "docker:clean": "docker-compose down -v && docker-compose -f docker-compose.dev.yml down -v"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
