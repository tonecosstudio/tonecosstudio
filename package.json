    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fast-check": "^4.5.3",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "^20.0.3",
    "lint-staged": "^15.5.2",
    "lovable-tagger": "^1.1.13",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "standard-version": "^9.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
