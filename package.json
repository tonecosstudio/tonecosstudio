{
  "name": "tonecosstudio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "catalog:monorepo:check": "node --test scripts/architecture/catalog-monorepo.test.mjs",
    "build": "npm run catalog:monorepo:check && node scripts/security/assert-catalog-mvp-build.mjs && node --test scripts/branding/generate-og-image.test.mjs scripts/cloudflare/catalog-pages-proxy.test.mjs scripts/security/assert-public-mvp-bundle.test.mjs scripts/seo/generate-public-index.test.mjs && vite build && node scripts/security/assert-public-mvp-bundle.mjs && node scripts/branding/generate-og-image.mjs && node scripts/seo/generate-public-index.mjs",
    "build:dev": "vite build --mode development",
    "typecheck": "tsc -b --pretty false",
    "typecheck:app": "tsc -p tsconfig.app.json --pretty false --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --pretty false --noEmit",
    "lint": "eslint .",
    "lint:prod": "eslint \"src/**/*.{ts,tsx}\" --ignore-pattern \"**/*.test.ts\" --ignore-pattern \"**/*.test.tsx\" --ignore-pattern \"src/test/**\"",
    "lint:tests": "eslint \"src/**/*.test.{ts,tsx}\" \"src/test/**/*.{ts,tsx}\"",
    "lint:architecture": "eslint \"src/**/*.{ts,tsx}\" --rule \"@typescript-eslint/no-explicit-any:off\"",
    "security:supabase-access": "node scripts/security/audit-supabase-access.mjs",
    "security:supabase-types": "node scripts/security/audit-supabase-types-ssot.mjs",
    "security:pricing-read-authority": "node scripts/security/audit-pricing-read-authority.mjs",
    "release:verify": "npm run typecheck && npm run lint && npm run security:supabase-access && npm run security:supabase-types && npm run security:pricing-read-authority && node scripts/security/audit-profile-authority.mjs && node scripts/security/audit-notification-authority.mjs && node scripts/security/audit-public-settings-authority.mjs && node scripts/security/audit-secure-upload-scanner.mjs && node scripts/security/audit-commercial-authority.mjs && npm run test:coverage && npm run build && npm audit --omit=dev --audit-level=high",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "cross-env NODE_OPTIONS='--max-old-space-size=4096' vitest run --coverage",
    "test:coverage:ui": "cross-env NODE_OPTIONS='--max-old-space-size=4096' vitest --ui --coverage",
    "test:performance": "cross-env VITEST_PERFORMANCE=true vitest run src/test/performance.test.ts",
    "test:e2e": "cross-env VITEST_INTEGRATION=true vitest run src/test/e2e-integration.test.ts",
    "catalog:import-drive": "node scripts/catalog/import-drive-manifest.mjs",
    "catalog:publish-ready": "node scripts/catalog/publish-ready-catalog-items.mjs",
    "catalog:dedupe": "node scripts/catalog/backfill-dedupe-metadata.mjs",
    "catalog:db-ready": "node scripts/catalog/catalog-db-readiness.mjs",
    "catalog:health": "node scripts/catalog/catalog-health-report.mjs",
    "catalog:health:strict": "node scripts/catalog/catalog-health-report.mjs --strict",
    "catalog:drive-plan": "node scripts/catalog/build-drive-organization-plan.mjs",
    "catalog:drive-appscript": "node scripts/catalog/generate-drive-apps-script.mjs",
    "catalog:drive-scrape-public": "node scripts/catalog/scrape-drive-public-folder.mjs",
    "catalog:export-drive-assets": "node scripts/catalog/export-drive-assets.mjs --download",
    "catalog:visual-groups": "node scripts/catalog/audit-drive-visual-groups.mjs",
    "catalog:visual-groups:fast": "node scripts/catalog/audit-drive-visual-groups.mjs --skip-sheets",
    "catalog:site-import-plan": "node scripts/catalog/build-drive-site-import-plan.mjs",
    "catalog:review-queue": "node scripts/catalog/build-drive-review-queue.mjs",
    "catalog:review-sheets": "node scripts/catalog/build-review-contact-sheets.mjs",
    "catalog:folder-contact-sheets": "node scripts/catalog/build-catalog-folder-contact-sheets.mjs",
    "catalog:clean-public-tags": "node scripts/catalog/clean-public-model-tags.mjs",
    "catalog:remove-backgrounds": "node scripts/catalog/remove-backgrounds-batch.mjs",
    "catalog:telegram-curation-groups": "node scripts/catalog/build-telegram-ptbr-curation-groups.mjs",
    "catalog:telegram-curation-decisions": "node scripts/catalog/build-telegram-curation-decision-sheet.mjs",
    "catalog:telegram-curation-sheets": "node scripts/catalog/build-telegram-curation-contact-sheets.mjs",
    "catalog:telegram-sequences": "node scripts/catalog/build-telegram-chronological-sequences.mjs",
    "catalog:telegram-name-queue": "node scripts/catalog/build-telegram-ptbr-name-queue.mjs",
    "catalog:telegram-normalize-webp-paths": "node scripts/catalog/normalize-telegram-webp-final-paths.mjs",
    "catalog:telegram-normalize-public-paths": "node scripts/catalog/normalize-telegram-webp-public-paths.mjs",
    "catalog:telegram-webp-final": "node scripts/catalog/build-telegram-webp-final.mjs",
    "catalog:telegram-webp-visual-overrides": "node scripts/catalog/apply-webp-visual-taxonomy-overrides.mjs",
    "catalog:telegram-webp-anime-taxonomy": "node scripts/catalog/apply-anime-webp-taxonomy-wave.mjs",
    "catalog:telegram-webp-site-import-plan": "node scripts/catalog/build-telegram-webp-site-import-plan.mjs",
    "catalog:ops-v2": "node scripts/catalog/bootstrap-catalog-ops-v2.mjs",
    "catalog:audit-manifest-coverage": "node scripts/catalog/audit-catalog-manifest-coverage.mjs",
    "catalog:audit-structure": "node scripts/catalog/audit-catalog-structure-suspects.mjs",
    "catalog:plan-staging-normalization": "node scripts/catalog/plan-catalog-staging-normalization.mjs",
    "catalog:plan-internal-variants": "node scripts/catalog/plan-catalog-internal-variant-normalization.mjs",
    "catalog:normalization-waves": "node scripts/catalog/report-catalog-staging-normalization-waves.mjs",
    "catalog:apply-staging-normalization": "node scripts/catalog/apply-catalog-staging-normalization-plan.mjs",
    "catalog:resolve-normalization-conflicts": "node scripts/catalog/resolve-catalog-staging-normalization-conflicts.mjs",
    "catalog:repair-manifest-coverage": "node scripts/catalog/repair-catalog-manifest-coverage.mjs",
    "catalog:restore-missing-physical": "node scripts/catalog/restore-catalog-missing-physical-from-source.mjs",
    "catalog:sync-manifest-case": "node scripts/catalog/sync-catalog-manifest-case-from-physical.mjs",
    "cloudflare:r2:upload-catalog": "node scripts/cloudflare/upload-catalog-webp-to-r2.mjs",
    "cloudflare:r2:import-queue": "node scripts/cloudflare/import-r2-catalog-queue.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\" \"*.{json,md}\"",
    "prepare": "husky",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "catalog:worker:test": "node --experimental-strip-types --test services/catalogo/tools/test_worker_media_contract.mjs services/catalogo/tools/test_gallery_validation.mjs services/catalogo/tools/test_gallery_aggregation.mjs services/catalogo/tools/test_model_aliases.mjs services/catalogo/tools/test_schema_contract.mjs services/catalogo/tools/test_worker_turnstile.mjs services/catalogo/tools/test_worker_folder_counts.mjs services/catalogo/tools/test_public_gallery_revision.mjs services/catalogo/tools/test_worker_gallery_contract.mjs services/catalogo/tools/test_worker_entry_integration.mjs",
    "catalog:worker:typecheck": "tsc -p services/catalogo/tsconfig.worker.json --noEmit",
    "catalog:worker:search:test": "cd services/catalogo && node --test tools/test_worker_catalog_facets.mjs tools/test_worker_catalog_scale_sqlite.mjs",
    "catalog:cutover:check": "node scripts/catalog/cutover-readiness.mjs --live",
    "catalog:mvp:test": "vitest run src/config/canonical-catalog-endpoint.test.ts src/services/catalog/approved-public-renders.test.ts src/pages/catalog/ApprovedModelShowcase.test.tsx src/services/catalog/public-catalog-gateway.test.ts src/pages/LandingPage.readonly.test.tsx src/pages/CatalogModelsArcade.integration.test.tsx src/pages/catalog/CanonicalModelDetails.integration.test.tsx src/pages/catalog/RelatedModels.test.ts src/components/catalog/CanonicalCatalogImage.test.tsx src/components/arcade/ArcadeNavView.test.tsx src/services/catalog/catalog-browsing-context.test.tsx src/services/customer/catalog-quote-service.test.ts src/services/quotes/catalog-quote-history-service.test.ts src/services/admin/config/catalog-quote-admin-service.test.ts src/services/customer/tonecos-account-service.test.ts src/services/customer/tonecos-account-service.local-preview.test.ts src/services/customer/__tests__/notification-preferences-service.test.ts src/services/customer/__tests__/notification-preferences-service.local-preview.test.ts src/pages/commercial/TonecosCommercialFlow.integration.test.tsx src/pages/CatalogArcade.integration.test.tsx src/pages/catalog/CanonicalUniverseFolders.integration.test.tsx src/pages/CatalogCharacterArcade.test.tsx src/pages/catalog/ModelDetailsRoute.test.tsx src/services/coins/tonecos-coins-service.test.ts src/pages/commercial/TonecosCoinsPage.test.tsx src/pages/commercial/TonecosPasswordRecoveryPage.test.tsx src/pages/commercial/TonecosAdminCoinsPage.test.tsx src/services/auth/auth-session-service.test.ts src/services/auth/tonecos-admin-access.test.ts src/services/admin/overview/tonart-admin-profiles-service.test.ts src/pages/commercial/TonecosAdminHomePage.test.tsx"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
