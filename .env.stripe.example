# =====================================================
# STRIPE CONFIGURATION
# =====================================================
#
# Configuração profissional do Stripe para pagamentos
#
# IMPORTANTE:
# 1. Copie este arquivo para .env.local
# 2. Preencha com suas chaves do Stripe
# 3. NUNCA commite as chaves reais no Git
#
# =====================================================

# -----------------------------------------------------
# STRIPE API KEYS
# -----------------------------------------------------
# Obtenha suas chaves em: https://dashboard.stripe.com/apikeys

# Chave secreta (server-side only)
# Use a Stripe secret key from the Dashboard.
STRIPE_SECRET_KEY=

# Chave publicável (client-side)
# Formato: pk_test_... (test) ou pk_live_... (production)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# -----------------------------------------------------
# STRIPE WEBHOOK
# -----------------------------------------------------
# Obtenha o webhook secret em: https://dashboard.stripe.com/webhooks

# Webhook signing secret
# Use the webhook signing secret from the endpoint configuration.
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------
# STRIPE CONFIGURATION
# -----------------------------------------------------

# Moeda padrão (ISO 4217)
VITE_STRIPE_CURRENCY=brl

# País padrão (ISO 3166-1 alpha-2)
VITE_STRIPE_COUNTRY=BR

# API Version (recomendado: manter atualizado)
VITE_STRIPE_API_VERSION=2023-10-16

# -----------------------------------------------------
# TESTING
# -----------------------------------------------------
# Cartões de teste: https://stripe.com/docs/testing

# Cartão de sucesso: 4242 4242 4242 4242
# Cartão que requer autenticação: 4000 0025 0000 3155
# Cartão que falha: 4000 0000 0000 9995

# -----------------------------------------------------
# WEBHOOK ENDPOINT
# -----------------------------------------------------
# Configure no Stripe Dashboard:
# URL: https://seu-dominio.com/api/webhooks/stripe
# Eventos recomendados:
# - payment_intent.succeeded
# - payment_intent.payment_failed
# - payment_intent.canceled
# - customer.subscription.created
# - customer.subscription.updated
# - customer.subscription.deleted
# - charge.refunded
# - invoice.payment_succeeded
# - invoice.payment_failed

# -----------------------------------------------------
# NOTAS DE SEGURANÇA
# -----------------------------------------------------
# 1. Use chaves de teste (sk_test_/pk_test_) em desenvolvimento
# 2. Use chaves de produção apenas em produção
# 3. Nunca exponha a chave secreta no frontend
# 4. Sempre valide webhooks com o webhook secret
# 5. Use HTTPS em produção
# 6. Implemente rate limiting nas rotas de pagamento
# 7. Monitore transações suspeitas no Stripe Dashboard
