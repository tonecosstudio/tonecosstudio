# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_WEBSITE_URL=https://ordax.com.br
VITE_SUPPORT_EMAIL=suporte@ordax.com.br
VITE_CONTACT_EMAIL=contato@ordax.com.br
VITE_PRIVACY_EMAIL=privacidade@ordax.com.br
VITE_DPO_EMAIL=dpo@ordax.com.br
VITE_COMPANY_NAME=Tonecos Studios
VITE_COMPANY_ADDRESS=Sao Paulo, Brasil
VITE_LEGAL_NAME=Tonecos Studios LTDA
VITE_COMPANY_LOGO_URL=/logo.png
VITE_FACEBOOK_URL=https://facebook.com/ordax
VITE_INSTAGRAM_URL=https://instagram.com/ordax
VITE_X_URL=https://x.com/ordax
VITE_YOUTUBE_URL=https://youtube.com/@ordax
VITE_CNPJ_PLACEHOLDER=00.000.000/0000-00
VITE_PHONE_PLACEHOLDER="+55 (11) 9999-9999"
VITE_BUSINESS_HOURS="Segunda a Sexta, 9h as 18h"
VITE_SHIPPING_BUSINESS_DAYS=5
VITE_PRODUCTION_DAYS_MIN=15
VITE_PRODUCTION_DAYS_MAX=20
VITE_SALES_DURATION_DAYS=30
VITE_DELIVERY_INTERVAL_DAYS=90
VITE_CHARACTER_CHOICE_DAYS=7
VITE_BALANCE_PAYMENT_DAYS=5

# Supabase service role key must be configured only as a server/Edge Function secret.
# Never expose it in VITE_* variables, browser bundles, docs, or committed examples.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Google OAuth (CONFIGURAR - Ver GUIA_CONFIGURACAO_CREDENCIAIS.md)
# Obter em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Stripe Configuration (CONFIGURAR - Ver GUIA_CONFIGURACAO_CREDENCIAIS.md)
# Obter em: https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here
# Server-side only. Configure as hosting/Edge Function secrets, never with VITE_*.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Edge Functions / CORS
SITE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com
BOOTSTRAP_ADMIN_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-cron-secret
EMAIL_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
CARRIER_TRACKING_API_URL=https://api.carrier.com/tracking
CARRIER_TRACKING_API_TOKEN=your-carrier-api-token

# Email Configuration (Optional)
RESEND_API_KEY=re_your-key-here
SENDGRID_API_KEY=SG.your-key-here

# OpenAI Configuration (Optional - for AI features)
OPENAI_API_KEY=

# Sentry (Optional - for error tracking)
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Environment
NODE_ENV=development
