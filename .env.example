# Tonecos MVP hosting: Cloudflare Pages account Tonecos, NOT Vercel.
# Supabase, Stripe and administrative cloud tooling below are for future commercial/isolated workflows, NOT readonly MVP.
# Catalog Worker origin (explicit Tonecos proxy; NEVER use ordax.com.br or direct R2)
VITE_CANONICAL_CATALOG_API_BASE=
# Catálogo público: modo somente leitura; os recursos comerciais abaixo ficam DESLIGADOS.
VITE_PUBLIC_CATALOG_MVP=true
VITE_PREVIEW_READ_ONLY=true
VITE_TONECOS_COMMERCIAL_MVP=false
VITE_CATALOG_QUOTES_ENABLED=false
VITE_TONECOS_COINS_ENABLED=false
# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_WEBSITE_URL=
VITE_SUPPORT_EMAIL=
VITE_CONTACT_EMAIL=
VITE_PRIVACY_EMAIL=
VITE_DPO_EMAIL=
VITE_COMPANY_NAME=TONART Studio
VITE_COMPANY_ADDRESS=
VITE_LEGAL_NAME=
VITE_COMPANY_LOGO_URL=/logo.png
VITE_CATALOG_ASSET_BASE_URL=
VITE_BUSINESS_HOURS="Segunda a Sexta, 9h as 18h"

# Operational deadlines, capacity, and commercial rules are authoritative in
# Supabase system_settings. Do not recreate them as browser-side VITE_* defaults.

# Supabase service role key must be configured only as a server/Edge Function secret.
# Never expose it in VITE_* variables, browser bundles, docs, or committed examples.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Legacy external catalog administrative tooling only. Do not run for Pages hosting, catalog imports, D1 scans or OrdaX resources.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_NAME=
CLOUDFLARE_ZONE_TYPE=full
CLOUDFLARE_PAGES_PROJECT=
CLOUDFLARE_PAGES_PRODUCTION_BRANCH=main
CLOUDFLARE_PAGES_CUSTOM_DOMAIN=
CLOUDFLARE_PRODUCTION_ORIGIN=
CLOUDFLARE_VERCEL_APEX_A_RECORD=
CLOUDFLARE_CATALOG_WORKER=
CLOUDFLARE_CATALOG_ROUTE=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=

# Google OAuth server credentials. Configure only in the environment that uses them.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Stripe
# Browser-safe publishable key.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here
# Server/Edge Function only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Edge Functions / CORS
SITE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://your-domain.com
BOOTSTRAP_ADMIN_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-cron-secret
EMAIL_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
CARRIER_TRACKING_API_URL=https://api.carrier.com/tracking
CARRIER_TRACKING_API_TOKEN=your-carrier-api-token

# Payment/support attachment malware scanning (Edge Function/server only)
# Point this to an HTTPS scanner gateway that accepts the raw file body and returns
# {"isClean":true} or {"safe":true}. Keep scanner credentials outside VITE_*.
MALWARE_SCANNER_URL=
MALWARE_SCANNER_TOKEN=
# Local development only. Production scanner transport must use HTTPS.
ALLOW_INSECURE_MALWARE_SCANNER=false

# Email Configuration (Optional)
RESEND_API_KEY=re_your-key-here
SENDGRID_API_KEY=SG.your-key-here

# OpenAI Configuration (Optional - for server-side AI features)
OPENAI_API_KEY=

# No remote browser error-monitoring provider is configured in the current codebase.
# Add provider-specific variables only together with a real, tested integration.

# Environment
NODE_ENV=development
