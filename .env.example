# ============================================================================
# 🌐 CONFIGURAÇÕES DE AMBIENTE
# ============================================================================

# Supabase Configuration
# Obtenha em: https://supabase.com/dashboard/project/[PROJECT_ID]/settings/api
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key-here"

# ============================================================================
# 💰 CONFIGURAÇÕES DE PREÇOS E PAGAMENTOS
# ============================================================================

# Preços padrão (fallback quando não há configuração no banco)
VITE_DEFAULT_PRICE_FULL=500
VITE_DEFAULT_PRICE_PIX=475
VITE_DEFAULT_DEPOSIT_AMOUNT=100

# Descontos
VITE_PIX_DISCOUNT_PERCENTAGE=5

# Parcelamento
VITE_MAX_INSTALLMENTS_NO_INTEREST=6
VITE_MAX_INSTALLMENTS_WITH_INTEREST=10

# ============================================================================
# 📦 CONFIGURAÇÕES DE PRODUÇÃO E LOTES
# ============================================================================

# Dias úteis para envio (5º dia útil)
VITE_SHIPPING_BUSINESS_DAYS=5

# Prazo para troca de coleções (dias antes do fechamento)
VITE_EXCHANGE_DEADLINE_DAYS=1

# Limite de ciclos futuros a calcular
VITE_FUTURE_BATCHES_COUNT=12

# ============================================================================
# 📧 CONFIGURAÇÕES DE EMAIL E CONTATO
# ============================================================================

VITE_SUPPORT_EMAIL="suporte@ordax.com.br"
VITE_CONTACT_EMAIL="contato@ordax.com.br"
VITE_PRIVACY_EMAIL="privacidade@ordax.com.br"
VITE_DPO_EMAIL="dpo@ordax.com.br"

VITE_WEBSITE_URL="https://ordax.com.br"
VITE_COMPANY_NAME="Tonecos Studios"
VITE_COMPANY_ADDRESS="São Paulo, Brasil"

# ============================================================================
# 📨 CONFIGURAÇÕES DE SERVIÇO DE EMAIL
# ============================================================================

# Email Provider: 'sendgrid' | 'ses' | 'smtp'
VITE_EMAIL_PROVIDER="smtp"

# Sender Configuration
VITE_EMAIL_FROM="noreply@ordax.com.br"
VITE_EMAIL_FROM_NAME="ORDAX"

# Retry Configuration
VITE_EMAIL_MAX_RETRIES=3
VITE_EMAIL_RETRY_DELAY=2000

# SendGrid Configuration (if using SendGrid)
# VITE_SENDGRID_API_KEY="your-sendgrid-api-key"

# AWS SES Configuration (if using AWS SES)
# VITE_AWS_SES_REGION="us-east-1"
# VITE_AWS_SES_ACCESS_KEY_ID="your-access-key-id"
# VITE_AWS_SES_SECRET_ACCESS_KEY="your-secret-access-key"

# SMTP Configuration (if using SMTP)
# VITE_SMTP_HOST="smtp.example.com"
# VITE_SMTP_PORT=587
# VITE_SMTP_USER="your-smtp-username"
# VITE_SMTP_PASSWORD="your-smtp-password"
# VITE_SMTP_SECURE=false

# ============================================================================
# 📦 CONFIGURAÇÕES DE TRANSPORTADORA E ENVIO
# ============================================================================

# Shipping Carrier: 'correios' | 'private'
VITE_SHIPPING_CARRIER="correios"

# Correios API Configuration
# VITE_SHIPPING_API_KEY="your-correios-api-key"
# VITE_SHIPPING_API_URL="https://api.correios.com.br"
# VITE_SHIPPING_CONTRACT_CODE="your-contract-code"
# VITE_SHIPPING_ADMIN_CODE="your-admin-code"

# Service Code (04014 = SEDEX, 04510 = PAC)
VITE_SHIPPING_SERVICE_CODE="04014"

# Retry Configuration
VITE_SHIPPING_MAX_RETRIES=3
VITE_SHIPPING_RETRY_DELAY=2000

# ============================================================================
# 🔔 CONFIGURAÇÕES DE NOTIFICAÇÕES E REALTIME
# ============================================================================

# Tempo para considerar usuário online (minutos)
VITE_USER_ONLINE_THRESHOLD=5

# Intervalo de polling para notificações (ms)
VITE_NOTIFICATION_POLLING_INTERVAL=30000

# Tempo de exibição de toast (ms)
VITE_TOAST_DURATION=5000

# ============================================================================
# 🎨 CONFIGURAÇÕES DE UI E UX
# ============================================================================

# Paginação
VITE_DEFAULT_PAGE_SIZE=20

# Debounce (ms)
VITE_SEARCH_DEBOUNCE=300
VITE_INPUT_DEBOUNCE=500

# Lazy loading
VITE_LAZY_LOAD_THRESHOLD=100

# Imagens
VITE_IMAGE_COMPRESSION_QUALITY=0.8
VITE_MAX_IMAGE_SIZE_MB=5

# ============================================================================
# 🔒 CONFIGURAÇÕES DE SEGURANÇA
# ============================================================================

# Retry e timeout
VITE_MAX_RETRY_ATTEMPTS=3
VITE_RETRY_DELAY=1000
VITE_REQUEST_TIMEOUT=30000

# Rate limiting
VITE_MAX_REQUESTS_PER_MINUTE=60

# ============================================================================
# 📊 CONFIGURAÇÕES DE ANALYTICS E LOGS
# ============================================================================

# Sentry (Opcional - para error tracking)
# Obtenha em: https://sentry.io
# VITE_SENTRY_DSN="https://your-dsn@sentry.io/project-id"
# VITE_ENABLE_SENTRY=true
# VITE_SENTRY_SAMPLE_RATE=1.0

# Logs
# VITE_ENABLE_DEBUG_LOGS=false

# ============================================================================
# 🎯 CONFIGURAÇÕES DE PLANOS E ASSINATURAS
# ============================================================================

# Dias para próxima entrega (padrão)
VITE_DAYS_TO_NEXT_DELIVERY=30

# Subscription Credit System API URL
# URL da API do sistema de assinaturas com créditos
VITE_SUBSCRIPTION_API_URL="http://localhost:3001"

# ============================================================================
# 🌍 CONFIGURAÇÕES DE LOCALIZAÇÃO
# ============================================================================

VITE_DEFAULT_LANGUAGE="pt-BR"
VITE_CURRENCY="BRL"
VITE_CURRENCY_SYMBOL="R$"
VITE_TIMEZONE="America/Sao_Paulo"

# ============================================================================
# 🚀 VERSÃO DA APLICAÇÃO
# ============================================================================

VITE_APP_VERSION="1.0.0"
