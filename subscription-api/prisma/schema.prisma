// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tabela: users (base - referenciada por outras tabelas)
model User {
  id               BigInt             @id @default(autoincrement())
  email            String             @unique
  name             String
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  
  subscriptions    Subscription[]
  userCredits      UserCredit?
  orders           Order[]
  creditTransactions CreditTransaction[]

  @@map("users")
}

// Tabela: subscription_plans
model SubscriptionPlan {
  id              BigInt         @id @default(autoincrement())
  planType        PlanType       @unique @map("plan_type")
  name            String
  durationMonths  Int            @map("duration_months")
  price           Decimal        @db.Decimal(10, 2)
  baseCredits     Int            @map("base_credits")
  bonusCredits    Int            @default(0) @map("bonus_credits")
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  
  subscriptions   Subscription[]

  @@index([planType])
  @@index([isActive])
  @@map("subscription_plans")
}

// Tabela: subscriptions
model Subscription {
  id                  BigInt              @id @default(autoincrement())
  userId              BigInt              @map("user_id")
  planType            PlanType            @map("plan_type")
  status              SubscriptionStatus
  startDate           DateTime            @map("start_date")
  endDate             DateTime            @map("end_date")
  nextBillingDate     DateTime?           @map("next_billing_date")
  autoRenew           Boolean             @default(true) @map("auto_renew")
  pendingPlanChange   PlanType?           @map("pending_plan_change")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  cancelledAt         DateTime?           @map("cancelled_at")
  cancellationType    CancellationType?   @map("cancellation_type")
  
  user                User                @relation(fields: [userId], references: [id])
  plan                SubscriptionPlan    @relation(fields: [planType], references: [planType])
  userCredits         UserCredit[]
  orders              Order[]
  creditTransactions  CreditTransaction[]

  @@index([userId])
  @@index([status])
  @@index([endDate])
  @@index([nextBillingDate])
  @@map("subscriptions")
}

// Tabela: user_credits
model UserCredit {
  id                BigInt       @id @default(autoincrement())
  userId            BigInt       @unique @map("user_id")
  subscriptionId    BigInt       @map("subscription_id")
  totalCredits      Int          @default(0) @map("total_credits")
  usedCredits       Int          @default(0) @map("used_credits")
  availableCredits  Int          @default(0) @map("available_credits")
  expiredCredits    Int          @default(0) @map("expired_credits")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  
  user              User         @relation(fields: [userId], references: [id])
  subscription      Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
  @@map("user_credits")
}

// Tabela: credit_transactions
model CreditTransaction {
  id                  BigInt            @id @default(autoincrement())
  userId              BigInt            @map("user_id")
  subscriptionId      BigInt            @map("subscription_id")
  transactionType     TransactionType   @map("transaction_type")
  creditsAmount       Int               @map("credits_amount")
  characterId         BigInt?           @map("character_id")
  orderId             BigInt?           @map("order_id")
  productionCycleId   BigInt?           @map("production_cycle_id")
  description         String?
  createdAt           DateTime          @default(now()) @map("created_at")
  
  user                User              @relation(fields: [userId], references: [id])
  subscription        Subscription      @relation(fields: [subscriptionId], references: [id])
  character           Character?        @relation(fields: [characterId], references: [id])
  order               Order?            @relation(fields: [orderId], references: [id])
  productionCycle     ProductionCycle?  @relation(fields: [productionCycleId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
  @@index([transactionType])
  @@index([createdAt])
  @@index([productionCycleId])
  @@map("credit_transactions")
}

// Tabela: characters
model Character {
  id                    BigInt              @id @default(autoincrement())
  name                  String
  description           String?
  priceCash             Decimal             @map("price_cash") @db.Decimal(10, 2)
  priceCredits          Int                 @map("price_credits")
  isExclusiveSemestral  Boolean             @default(false) @map("is_exclusive_semestral")
  isActive              Boolean             @default(true) @map("is_active")
  isStandardCollection  Boolean             @default(false) @map("is_standard_collection")
  imageUrl              String?             @map("image_url")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  
  orderItems            OrderItem[]
  creditTransactions    CreditTransaction[]

  @@index([isActive])
  @@index([isExclusiveSemestral])
  @@index([isStandardCollection])
  @@map("characters")
}

// Tabela: production_cycles
model ProductionCycle {
  id                  BigInt              @id @default(autoincrement())
  name                String
  capacityLimit       Int                 @map("capacity_limit")
  currentCount        Int                 @default(0) @map("current_count")
  status              CycleStatus         @default(open)
  closeDate           DateTime            @map("close_date")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  closedAt            DateTime?           @map("closed_at")
  
  orders              Order[]
  cycleLimits         CycleLimit[]
  creditTransactions  CreditTransaction[]

  @@index([status])
  @@index([closeDate])
  @@map("production_cycles")
}

// Tabela: orders
model Order {
  id                  BigInt          @id @default(autoincrement())
  userId              BigInt          @map("user_id")
  subscriptionId      BigInt          @map("subscription_id")
  productionCycleId   BigInt          @map("production_cycle_id")
  orderType           OrderType       @map("order_type")
  status              OrderStatus
  isPriority          Boolean         @default(false) @map("is_priority")
  isLocked            Boolean         @default(false) @map("is_locked")
  totalCredits        Int             @default(0) @map("total_credits")
  creditsDebited      Boolean         @default(false) @map("credits_debited")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  lockedAt            DateTime?       @map("locked_at")
  
  user                User            @relation(fields: [userId], references: [id])
  subscription        Subscription    @relation(fields: [subscriptionId], references: [id])
  productionCycle     ProductionCycle @relation(fields: [productionCycleId], references: [id])
  orderItems          OrderItem[]
  creditTransactions  CreditTransaction[]

  @@index([userId])
  @@index([subscriptionId])
  @@index([productionCycleId])
  @@index([orderType])
  @@index([status])
  @@index([isPriority])
  @@map("orders")
}

// Tabela: order_items
model OrderItem {
  id          BigInt    @id @default(autoincrement())
  orderId     BigInt    @map("order_id")
  characterId BigInt    @map("character_id")
  creditsCost Int       @map("credits_cost")
  createdAt   DateTime  @default(now()) @map("created_at")
  
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id])

  @@unique([orderId, characterId], name: "unique_order_character")
  @@index([orderId])
  @@index([characterId])
  @@map("order_items")
}

// Tabela: cycle_limits
model CycleLimit {
  id                  BigInt          @id @default(autoincrement())
  productionCycleId   BigInt          @map("production_cycle_id")
  planType            PlanTypeOrGlobal? @map("plan_type")
  characterLimit      Int             @map("character_limit")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  
  productionCycle     ProductionCycle @relation(fields: [productionCycleId], references: [id])

  @@unique([productionCycleId, planType], name: "unique_cycle_plan")
  @@index([productionCycleId])
  @@index([planType])
  @@map("cycle_limits")
}

// Enums
enum PlanType {
  trimestral
  semestral
}

enum PlanTypeOrGlobal {
  trimestral
  semestral
  global
}

enum SubscriptionStatus {
  active
  expired
  cancelled
}

enum CancellationType {
  with_refund
  no_renewal
}

enum TransactionType {
  allocation
  debit_immediate
  debit_cycle_close
  expiration
  adjustment
}

enum CycleStatus {
  open
  full
  closed
}

enum OrderType {
  individual
  automatic
}

enum OrderStatus {
  pending
  confirmed
  in_production
  shipped
  cancelled
}
