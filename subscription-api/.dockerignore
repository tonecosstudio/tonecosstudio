# ============================================
# Docker Ignore File
# ============================================

# Node modules (will be installed in container)
node_modules/
npm-debug.log
yarn-error.log
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build output (will be built in container)
dist/
build/

# Environment files (use docker secrets/env vars)
.env
.env.*
!.env.example

# Git
.git/
.gitignore
.gitattributes

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
coverage/
.nyc_output/
**/*.test.ts
tests/

# Documentation
*.md
!README.md
docs/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Docker
Dockerfile
.dockerignore
docker-compose*.yml

# Logs
logs/
*.log

# Prisma migrations (handled separately)
prisma/migrations/
