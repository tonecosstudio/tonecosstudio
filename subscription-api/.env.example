# ============================================
# SERVER CONFIGURATION
# ============================================

# Porta em que o servidor irá rodar
PORT=3000

# Ambiente de execução: development | production | test
# - development: logs detalhados, hot reload
# - production: logs otimizados, sem hot reload
# - test: configurações para testes automatizados
NODE_ENV=development


# ============================================
# DATABASE CONFIGURATION
# ============================================

# URL de conexão com PostgreSQL
# Formato: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
#
# Desenvolvimento local:
DATABASE_URL="postgresql://user:password@localhost:5432/subscription_credit_system?schema=public"
#
# Exemplo de produção:
# DATABASE_URL="postgresql://admin:securepass@db.example.com:5432/prod_db?schema=public&connection_limit=10"
#
# Notas:
# - Substitua 'user' e 'password' pelas credenciais do seu PostgreSQL
# - O banco 'subscription_credit_system' será criado automaticamente pelo script init-db
# - Em produção, use connection pooling (adicione &connection_limit=10)


# ============================================
# JWT AUTHENTICATION
# ============================================

# Chave secreta para assinar tokens JWT
# IMPORTANTE: Use uma string aleatória longa e única em produção!
# Gere uma chave segura com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-here

# Tempo de expiração dos tokens
# Formatos aceitos: 7d (7 dias), 24h (24 horas), 30m (30 minutos)
JWT_EXPIRES_IN=7d


# ============================================
# PAYMENT GATEWAY CONFIGURATION
# ============================================

# Provider de pagamento a ser utilizado
# Opções disponíveis:
# - stub: Simulação de pagamentos (desenvolvimento/testes)
# - stripe: Integração com Stripe
# - mercadopago: Integração com Mercado Pago
PAYMENT_GATEWAY_PROVIDER=stub


# --------------------------------------------
# Stripe Configuration
# --------------------------------------------
# Necessário apenas se PAYMENT_GATEWAY_PROVIDER=stripe
# Obtenha suas chaves em: https://dashboard.stripe.com/apikeys

# Chave secreta da API Stripe
# Desenvolvimento: sk_test_...
# Produção: sk_live_...
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Secret para validar webhooks do Stripe
# Obtenha em: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret


# --------------------------------------------
# Mercado Pago Configuration
# --------------------------------------------
# Necessário apenas se PAYMENT_GATEWAY_PROVIDER=mercadopago
# Obtenha seu token em: https://www.mercadopago.com.br/developers/panel

# Access Token do Mercado Pago
# MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token


# ============================================
# EMAIL / NOTIFICATIONS CONFIGURATION
# ============================================

# Servidor SMTP para envio de emails
# Exemplos de provedores:
# - Gmail: smtp.gmail.com
# - SendGrid: smtp.sendgrid.net
# - Mailgun: smtp.mailgun.org
# - Amazon SES: email-smtp.us-east-1.amazonaws.com
SMTP_HOST=smtp.example.com

# Porta SMTP
# - 587: TLS (recomendado)
# - 465: SSL
# - 25: Sem criptografia (não recomendado)
SMTP_PORT=587

# Credenciais de autenticação SMTP
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password

# Email que aparecerá como remetente
EMAIL_FROM=noreply@example.com


# ============================================
# OPTIONAL CONFIGURATIONS
# ============================================

# Habilitar logs detalhados (true/false)
# DEBUG=true

# Timeout para requisições HTTP em milissegundos
# HTTP_TIMEOUT=30000

# Número máximo de conexões simultâneas ao banco
# DB_POOL_SIZE=10
