# ============================================
# ORDAX - Environment Variables Template
# ============================================
#
# INSTRUÇÕES:
# 1. Copie este arquivo para .env.local
# 2. Preencha as variáveis marcadas com [CONFIGURAR]
# 3. Siga o guia: GUIA_CONFIGURACAO_CREDENCIAIS.md
# 4. NUNCA commite .env.local no Git!
#
# ============================================

# Vercel (Gerado automaticamente - NÃO MODIFICAR)
VERCEL_OIDC_TOKEN="seu-token-vercel-aqui"

# ============================================
# SUPABASE (✅ JÁ CONFIGURADO)
# ============================================
VITE_SUPABASE_URL="[CONFIGURAR]"
VITE_SUPABASE_PUBLISHABLE_KEY="[CONFIGURAR]"
SUPABASE_SERVICE_ROLE_KEY="[CONFIGURAR_APENAS_EM_AMBIENTE_SERVER]"

# ============================================
# GOOGLE OAUTH [CONFIGURAR] 🔴 CRÍTICO
# ============================================
# Obter em: https://console.cloud.google.com/apis/credentials
# Guia: GUIA_CONFIGURACAO_CREDENCIAIS.md - Passo 1
#
# Formato esperado:
# GOOGLE_CLIENT_ID="123456789-abc123.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-abc123def456"
#
GOOGLE_CLIENT_ID="[CONFIGURAR]"
GOOGLE_CLIENT_SECRET="[CONFIGURAR]"

# ============================================
# STRIPE [CONFIGURAR] 🔴 CRÍTICO
# ============================================
# Obter em: https://dashboard.stripe.com/test/apikeys
# Guia: GUIA_CONFIGURACAO_CREDENCIAIS.md - Passo 2
#
# IMPORTANTE: Use Test Mode keys durante desenvolvimento!
#
# Formato esperado:
# VITE_STRIPE_PUBLISHABLE_KEY="pk_test_51..."
# STRIPE_SECRET_KEY="sk_test_51..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
#
VITE_STRIPE_PUBLISHABLE_KEY="[CONFIGURAR]"
STRIPE_SECRET_KEY="[CONFIGURAR]"
STRIPE_WEBHOOK_SECRET="[CONFIGURAR]"

# ============================================
# EDGE FUNCTIONS / CORS [CONFIGURAR]
# ============================================
SITE_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,https://seu-dominio.com"
BOOTSTRAP_ADMIN_SECRET="[CONFIGURAR_SEGREDO_LONGO_ALEATORIO]"
CRON_SECRET="[CONFIGURAR_SEGREDO_LONGO_ALEATORIO]"
EMAIL_WEBHOOK_SECRET="[CONFIGURAR_SEGREDO_LONGO_ALEATORIO]"

# ============================================
# EMAIL (OPCIONAL) 🟡
# ============================================
# Escolha um provedor de email:
# - Resend: https://resend.com/api-keys
# - SendGrid: https://app.sendgrid.com/settings/api_keys
#
RESEND_API_KEY=""
SENDGRID_API_KEY=""

# ============================================
# OPENAI (OPCIONAL) 🟡
# ============================================
# Para features de AI (se implementadas)
# Obter em: https://platform.openai.com/api-keys
#
OPENAI_API_KEY=""

# ============================================
# SENTRY (OPCIONAL) 🟡
# ============================================
# Para error tracking em produção
# Obter em: https://sentry.io/settings/projects/
#
VITE_SENTRY_DSN=""

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=development

# ============================================
# VALIDAÇÃO
# ============================================
# Após configurar, execute:
# 1. npm run dev
# 2. Teste login com Google
# 3. Teste pagamento com Stripe
#
# Cartão de teste Stripe:
# Número: 4242 4242 4242 4242
# Data: Qualquer data futura
# CVC: Qualquer 3 dígitos
# ============================================
