# ============================================
# MALWARE SCANNER (server/Edge Function only)
# ============================================
# HTTPS gateway used by payment/support uploads. It must accept the raw file body
# and return JSON with isClean/safe boolean. Never expose scanner credentials in VITE_*.
MALWARE_SCANNER_URL=""
MALWARE_SCANNER_TOKEN=""
# Use true only for local development with a trusted HTTP scanner endpoint.
ALLOW_INSECURE_MALWARE_SCANNER="false"

